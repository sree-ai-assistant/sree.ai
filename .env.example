# --- Backend Environment Variables ---
PORT=5000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# NVIDIA NIM API (for AI Chat, Voice, Image)
NVIDIA_API_KEY=your_nvidia_api_key

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# PostHog Analytics & Error Tracking (backend)
POSTHOG_PROJECT_TOKEN=your_posthog_project_token
POSTHOG_HOST=https://us.i.posthog.com

# --- Frontend Environment Variables ---
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_BASE_URL=http://localhost:5000/api

# Feature Request Webhook (backend only)
FEATURE_REQUEST_WEBHOOK_URL=https://n8n.nil.flare.my.to/webhook-test/your-webhook-id
FEATURE_REQUEST_WEBHOOK_SECRET=your_webhook_secret
